{
  "name": "@neabyte/l4rpc",
  "description": "Stateless TCP procedure call library built for daemon services",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "unbuild --minify",
    "clean": "rm -rf dist",
    "prepublishOnly": "rm -rf dist && npm run build"
  },
  "keywords": [
    "backend",
    "client-server",
    "daemon",
    "deno",
    "framing",
    "ipc",
    "json-rpc",
    "jsr",
    "length-prefixed",
    "microservices",
    "networking",
    "protocol",
    "rpc",
    "socket",
    "stateless",
    "tcp",
    "tcp-client",
    "tcp-server",
    "transport",
    "typescript"
  ],
  "dependencies": {
    "@neabyte/byte-tokenizer": "^0.1.0"
  },
  "devDependencies": {
    "@typescript/typescript6": "^6.0.2",
    "unbuild": "^3.6.1"
  },
  "author": {
    "name": "NeaByteLab",
    "email": "me@neabyte.com",
    "url": "https://github.com/NeaByteLab"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NeaByteLab/L4RPC.git"
  },
  "bugs": {
    "url": "https://github.com/NeaByteLab/L4RPC/issues"
  },
  "homepage": "https://github.com/NeaByteLab/L4RPC#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
